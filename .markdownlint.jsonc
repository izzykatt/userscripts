// markdownlint rule set for this repository. `listings/.markdownlint.jsonc`
// extends this file and relaxes two more rules for listing bodies.
//
// A rule is disabled here only when GitHub's default house style is wrong for
// this repository's Markdown, which has two unusual audiences:
//
//   * listings/*.md is PASTED INTO A WEB FORM on Sleazy Fork. It is a body
//     fragment, not a document, and the form does not rewrap.
//   * CHANGELOG.md is a 170 KB engineering record whose headings repeat by
//     design (Keep a Changelog repeats `#### Fixed` under every release).
//
// Rules that catch things which actually RENDER WRONG stay ON. MD018 in
// particular found four real bugs: a paragraph beginning `#main_list …`
// renders as an <h1> on GitHub, because an ATX heading may interrupt a
// paragraph. Do not turn it off — backtick the selector instead.
{
  // Long lines are deliberate: a listing body is pasted into a form, and a
  // CHANGELOG entry quotes measured selectors that must not be broken.
  "MD013": false,

  // Inline HTML is deliberate: shields.io badges, <pre> in listing bodies,
  // and prose that names HTML elements (<article>, <header>) without
  // backticks in older entries.
  "MD033": false,

  // Bare URLs are deliberate: a listing body is pasted as plain text, where
  // an autolink's angle brackets are noise.
  "MD034": false,

  // `|---|---|` compact table pipes are this repository's house style.
  "MD060": false,

  // Keep a Changelog repeats `#### Fixed` under every release heading.
  // siblings_only still catches a genuine duplicate within one release.
  "MD024": { "siblings_only": true }
}
