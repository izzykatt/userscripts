// Overrides for Claude Code's own project files. `extends` is load-bearing:
// without it this file REPLACES the root rule set rather than adding to it.
{
  "extends": "../.markdownlint.jsonc",

  // A slash command and a rule file are PROMPT BODIES, not documents. Their
  // frontmatter carries the title, so a top-level heading inside would
  // duplicate it.
  "MD041": false
}
